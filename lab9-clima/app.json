{
  "expo": {
    "name": "Clima",
    "slug": "clima",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1e3c72"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Clima cần vị trí của bạn để hiển thị thời tiết hiện tại."
      }
    },
    "android": {
      "package": "com.yourname.clima",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Clima cần vị trí của bạn để hiển thị thời tiết hiện tại."
        }
      ]
    ]
  }
}
